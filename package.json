{
  "name": "dsh-utodo",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "author": "HauWong",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "todo",
    "notes",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HauWong/dsh-utodo.git"
  },
  "homepage": "https://github.com/HauWong/dsh-utodo#readme",
  "bugs": {
    "url": "https://github.com/HauWong/dsh-utodo/issues"
  },
  "description": "待办与想法：DSH 左侧栏全局面板，待办支持单日 / 日期区间，想法支持标签",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README-EN.md",
    "LICENSE"
  ]
}
